# App
APP_NAME=오늘의 3
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./tome.db
FRONTEND_ORIGIN=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Seoul

# Seeded accounts (created on startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=관리자
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=user12345
TEST_USER_NAME=테스트유저

# Kakao developers (https://developers.kakao.com)
# Redirect URI must match exactly (OAuth signup/login callback):
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback

# Free LLM — Groq (recommended to start)
# 1) https://console.groq.com 에서 무료 API 키 발급
# 2) 아래 키만 넣으면 됨 (base/model 기본값 자동)
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# OpenAI를 쓰려면:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
