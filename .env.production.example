# Tunnel / home host. Copy to `.env.production`. Loaded by `.\run-prod.ps1` (APP_ENV=production).
# Do not use `.env`.

APP_NAME=하루만장
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./tome.db
DEFAULT_TIMEZONE=Asia/Seoul
# Concurrent personalized schedule jobs (2–3 recipients). Cap is 8.
SCHEDULER_MAX_PARALLEL=3
# Scheduled digest: prepare N minutes before slot; send grace after slot (minutes).
SCHEDULE_PREP_LEAD_MINUTES=30
SCHEDULE_SEND_GRACE_MINUTES=60
SCHEDULE_SEND_CATCHUP_MINUTES=180

# Seed accounts: ADMIN_* and TEST_USER_* are NOT created.
# Matching leftover emails are purged on boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=관리자
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=user12345
TEST_USER_NAME=테스트유저

FRONTEND_ORIGIN=https://todays3.muhak.store
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Kakao Developers: also register the local Redirect URI.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://todays3.muhak.store/auth/kakao/callback

LLM_PROVIDER=hybrid
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Groq Free openai/gpt-oss-120b: 30 RPM, 8K TPM. Headroom is applied in code (0.85).
# In-flight calls stay at 1 on this tier (TPM binds before RPM).
LLM_TPM_LIMIT=8000
LLM_RPM_LIMIT=30
LLM_MAX_CONCURRENT=1
# Local Qwen2.5-1.5B via host Ollama only (not Groq). hybrid tries local first, then Groq.
# Digest curate/critique skip local by default (LLM_DIGEST_PREFER_REMOTE) — local JSON is 1–5 min.
# CPU: LLM_LOCAL_MAX_CONCURRENT * LLM_LOCAL_NUM_THREAD never uses every core.
LLM_LOCAL_ENABLED=true
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LLM_LOCAL_MODEL=qwen2.5:1.5b
LLM_LOCAL_NUM_CTX=4096
LLM_LOCAL_MAX_CONCURRENT=1
LLM_LOCAL_NUM_THREAD=2
LLM_LOCAL_MLOCK=true
LLM_LOCAL_TIMEOUT_SECONDS=25
LLM_DIGEST_PREFER_REMOTE=true

# YouTube Data API v3 (same key youtube-mcp uses). Empty → channel RSS fallback.
YOUTUBE_API_KEY=

# Firebase Cloud Messaging. Empty → Kakao still sends, no device push.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_VAPID_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com

# Android MacroDroid/Tasker → POST https://todays3.muhak.store/api/v1/hooks/notifications
FLASH_WEBHOOK_SECRET=
# FLASH_ALERT_USER_EMAIL=admin@example.com

# Agentic enrichment. MiniLM/FAISS off by default (16GB RAM).
AGENT_ENRICHMENT_ENABLED=false
DIGEST_CRITIQUE_ENABLED=false
AGENT_FAISS_ENABLED=false
FINANCE_DB_PATH=
NOTION_API_KEY=
NOTION_DATABASE_ID=
KAKAO_WEBHOOK_SECRET=

# DART XBRL + PDF FTS5. Ingest/OCR stay off unless DART_API_KEY is set.
DART_API_KEY=
DART_DB_PATH=/data/dart_financials.db
DART_INGEST_ENABLED=false
DART_OCR_ENABLED=false
DART_TICKERS=005930,000660

